    "command": "cd /opt/Proyectos/Oeditus/ragex && mix ragex.cache.stats",
    "reveal": "always",
    "use_new_terminal": false,
    "allow_concurrent_runs": false
  },
  {
    "label": "ragex: cache refresh",
    "command": "cd /opt/Proyectos/Oeditus/ragex && mix ragex.cache.refresh --path \"$ZED_WORKTREE_ROOT\"",
    "reveal": "always",
    "use_new_terminal": false,
    "allow_concurrent_runs": false
  },
  {
    "label": "ragex: cache refresh (full)",
    "command": "cd /opt/Proyectos/Oeditus/ragex && mix ragex.cache.refresh --path \"$ZED_WORKTREE_ROOT\" --full",
