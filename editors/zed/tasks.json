    "allow_concurrent_runs": false
  },

  // ── Build ──────────────────────────────────────────────────────────────
  {
    "label": "ragex: compile",
    "command": "cd /opt/Proyectos/Oeditus/ragex && mix compile",
    "reveal": "always",
    "use_new_terminal": false,
