#!/usr/bin/env bash
#
# ragex-mcp -- Start Ragex as an MCP server in stdio mode.
#
# Designed for editors that communicate with MCP servers over stdin/stdout
# (Zed, Cursor, Claude Desktop, etc.).
#
# Usage:
#   bin/ragex-mcp                          # basic startup
#   bin/ragex-mcp --project /path/to/code  # auto-analyze a project on startup
#   bin/ragex-mcp --log-level debug        # override log level
#
# Environment variables (all optional):
#   RAGEX_PROJECT          -- same as --project
#   RAGEX_LOG_LEVEL        -- same as --log-level (default: info)
#   RAGEX_EMBEDDING_MODEL  -- embedding model to use

set -euo pipefail

# NOTE: do NOT use `kill 0` here. `kill 0` signals every process in the
# *caller's process group*, not just this script's own children. Editors
# that launch us via a non-detached job (e.g. Neovim's `jobstart()` without
# `detach = true`) put this script in the *same* process group as the
# editor itself. Since this script has no backgrounded jobs of its own left
# running past the final `exec` below, there is nothing here that actually
# needs group-wide cleanup -- but `kill 0` firing on *any* early exit
# (including the normal "not an Elixir project, skipping startup" path)
# would instantly SIGTERM the whole group, taking the host editor down with
# it. Scope cleanup to this script's own direct children instead.
cleanup() {
  pkill -TERM -P $$ 2>/dev/null || true
}
trap cleanup EXIT TERM INT

ORIGINAL_PWD="$PWD"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"

cd "$PROJECT_DIR"

# -- Defaults ---------------------------------------------------------------
PROJECT="${RAGEX_PROJECT:-}"
LOG_LEVEL="${RAGEX_LOG_LEVEL:-info}"

# -- Parse arguments --------------------------------------------------------
while [[ $# -gt 0 ]]; do
  case "$1" in
    --project)
      PROJECT="$2"
      shift 2
      ;;
    --project=*)
      PROJECT="${1#*=}"
      shift
      ;;
    --log-level)
      LOG_LEVEL="$2"
      shift 2
      ;;
    --log-level=*)
      LOG_LEVEL="${1#*=}"
      shift
      ;;
    --help|-h)
      cat <<'EOF'
Usage: ragex-mcp [--project PATH] [--log-level LEVEL]

Start Ragex as an MCP server communicating over stdio.

Options:
  --project PATH    Auto-analyze a project directory on startup
  --log-level LEVEL Set log level (debug|info|warning|error)

Environment:
  RAGEX_PROJECT          Same as --project
  RAGEX_LOG_LEVEL        Same as --log-level (default: info)
  RAGEX_EMBEDDING_MODEL  Embedding model to use
EOF
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      exit 1
      ;;
  esac
done

# -- Auto-detect Elixir project if not explicitly set -----------------------
if [[ -z "$PROJECT" ]]; then
  find_mix_exs() {
    local dir="$1"
    while [[ "$dir" != "/" ]]; do
      if [[ -f "$dir/mix.exs" ]]; then
        echo "$dir"
        return 0
      fi
      dir="$(dirname "$dir")"
    done
    return 1
  }

  PROJECT="$(find_mix_exs "$ORIGINAL_PWD" || true)"
  if [[ -z "$PROJECT" ]]; then
    echo "[ragex-mcp] Not an Elixir project (no mix.exs found in $ORIGINAL_PWD or parents). Skipping startup." >&2
    exit 0
  fi
fi

# -- Environment for MCP stdio mode -----------------------------------------
export MIX_ENV=prod
export RAGEX_STDIO=1
export LOG_LEVEL="$LOG_LEVEL"

if [[ -n "$PROJECT" ]]; then
  export RAGEX_AUTO_ANALYZE="$PROJECT"
  export RAGEX_AUTO_ANALYZE_DIRS="${RAGEX_AUTO_ANALYZE_DIRS:-$PROJECT}"
  export RAGEX_STORE_BACKEND="${RAGEX_STORE_BACKEND:-dllb}"
  export RAGEX_DLLB_MODE="${RAGEX_DLLB_MODE:-per_project}"
fi

# -- Resolve the MCP socket path ---------------------------------------------
# Multiple independent ragex-mcp instances (different projects, different
# dllb ports) may be running at once. Namespace the socket so they never
# collide. This precedence MUST match Ragex.MCP.SocketPath.compute_string/0:
#   1. RAGEX_MCP_SOCK (explicit override, used verbatim)
#   2. DLLB_PORT      (namespace by dllb server port)
#   3. otherwise       namespace by the project identity (sanitized)
if [[ -n "${RAGEX_MCP_SOCK:-}" ]]; then
  SOCKET_PATH="$RAGEX_MCP_SOCK"
elif [[ -n "${DLLB_PORT:-}" ]]; then
  SOCKET_PATH="/tmp/ragex_mcp_${DLLB_PORT}.sock"
else
  IDENTITY="${PROJECT:-$ORIGINAL_PWD}"
  ABS_IDENTITY="$(cd "$IDENTITY" 2>/dev/null && pwd || echo "$IDENTITY")"
  SANITIZED=$(printf '%s' "$ABS_IDENTITY" | sed -e 's#^/##' -e 's#[^A-Za-z0-9]#_#g' -e 's#_*$##')
  SOCKET_PATH="/tmp/ragex_mcp_${SANITIZED}.sock"
fi
export RAGEX_MCP_SOCK="$SOCKET_PATH"

# -- Detect running instance ------------------------------------------------
# If a Ragex server is already listening on the Unix socket, bridge to it
# instead of starting a second BEAM VM (which would OOM on GPU allocation).

if [[ -S "$SOCKET_PATH" ]]; then
  # Try a lightweight ping via the socket to confirm it's alive.
  # Send MCP ping, read one response line, check for "result".
  PING='{"jsonrpc":"2.0","id":0,"method":"ping","params":{}}'
  # timeout 2s: if no response, server is stale
  PONG=$( (echo "$PING" | timeout 2 socat - UNIX-CONNECT:"$SOCKET_PATH" 2>/dev/null | head -1) || true )

  if echo "$PONG" | grep -q '"result"'; then
    echo "[ragex-mcp] Reusing running server via $SOCKET_PATH" >&2
    exec "$SCRIPT_DIR/ragex-bridge"
  else
    rm -f "$SOCKET_PATH"
  fi
fi

# -- No running instance, start full server ---------------------------------

# Compile silently (all output to stderr so it never pollutes stdio JSON-RPC)
mix compile >&2 2>&1

# Run the server (only JSON-RPC goes to stdout)
exec mix run --no-halt --no-compile
